# The Vex agent worker. Build from the repo root: the agent reads
# src/deck.json and public/spoken.js.
FROM node:22-bookworm-slim

WORKDIR /app/agent
ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY agent/package*.json ./
RUN npm ci --omit=dev

COPY agent/*.js ./
COPY src/deck.json /app/src/deck.json
COPY public/spoken.js /app/public/spoken.js

CMD ["node", "agent.js", "start"]
